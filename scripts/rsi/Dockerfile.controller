# The trusted controller needs Git for immutable source admission and the
# native libraries imported by OSWorld's base (non-GPU) environment. The model
# container remains the separate, unprivileged pinned runtime.
FROM ghcr.io/astral-sh/uv@sha256:e5b65587bce7de595f299855d7385fe7fca39b8a74baa261ba1b7147afa78e58
ARG DEBIAN_MIRROR=https://deb.debian.org
# Alternate transport mirrors still require the Debian-signed Release metadata
# and package hashes. Never add trusted=yes or disable TLS/signature checks.
RUN sed -i "s|http://deb.debian.org|${DEBIAN_MIRROR}|g" /etc/apt/sources.list.d/debian.sources \
    && apt-get -o Acquire::Retries=2 -o Acquire::https::Timeout=30 update \
    && apt-get -o Acquire::Retries=2 -o Acquire::https::Timeout=30 install -y --no-install-recommends git libgl1 libglib2.0-0 \
    && apt-get clean
# OSWorld's declared pynput dependency builds evdev on Linux. These headers
# belong only to the controller build, never to model/guest permissions.
RUN apt-get -o Acquire::Retries=2 -o Acquire::https::Timeout=30 install -y --no-install-recommends build-essential linux-libc-dev \
    && apt-get clean
LABEL org.trace2task.rsi.component="trusted-controller"
